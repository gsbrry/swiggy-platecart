# Copy to .env.local to override the committed public values (e.g. to point at another Supabase project).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Canonical site URL used in auth emails and share links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
