DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
# Swiggy MCP — OAuth 2.1 + PKCE per user. See docs/SWIGGY_MCP_INTEGRATION.md
SWIGGY_MCP_BASE_URL=https://mcp.swiggy.com
SWIGGY_MCP_CLIENT_ID=
SWIGGY_MCP_CLIENT_SECRET=
SWIGGY_REDIRECT_URI=http://localhost:3000/api/auth/swiggy/callback
# 32-byte base64 key for AES-GCM at-rest encryption of stored access tokens
SWIGGY_TOKEN_ENC_KEY=
# Legacy — kept only for the pre-OAuth stub; will be removed with 2.1
SWIGGY_MCP_API_KEY=
